{
  "rules": {
    "config": {
      ".read": "auth != null",
      ".write": "auth.token.email === 'aluizio@aluizio.education'"
    },
    "autorizados": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      ".write": "auth.token.email === 'aluizio@aluizio.education'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'"
      }
    },
    "pendentes": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'"
      }
    },
    "progresso": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.uid === $uid"
      }
    },
    "docs": {
      ".read": "(auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
      ".write": false
    },
    "crises": {
      ".read": "(auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
      ".write": "auth.token.email === 'aluizio@aluizio.education'"
    },
    "respostas": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      ".write": "auth.token.email === 'aluizio@aluizio.education'",
      "$cid": {
        "$uid": {
          ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'",
          ".write": "auth.uid === $uid && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())"
        }
      }
    },
    "comites": {
      ".read": "auth != null && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
      ".write": "auth.token.email === 'aluizio@aluizio.education'"
    },
    "delegacoes": {
      "$comiteId": {
        ".read": "auth != null && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
        ".write": "auth.token.email === 'aluizio@aluizio.education'",
        "$delegacaoId": {
          "membros": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education') && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())"
            }
          }
        }
      }
    },
    "minhaDelegacao": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education') && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())"
      }
    },
    "docsDelegacao": {
      "$comiteId": {
        ".read": "auth.token.email === 'aluizio@aluizio.education'",
        "$delegacaoId": {
          ".read": "root.child('delegacoes').child($comiteId).child($delegacaoId).child('membros').child(auth.uid).val() === true && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
          "$docId": {
            ".write": "auth.token.email === 'aluizio@aluizio.education' || (root.child('delegacoes').child($comiteId).child($delegacaoId).child('membros').child(auth.uid).val() === true && (!data.exists() || data.child('estado').val() === 'rascunho') && (root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists()))"
          }
        }
      }
    },
    "feedback": {
      "$comiteId": {
        ".read": "auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.token.email === 'aluizio@aluizio.education'",
        "$delegacaoId": {
          ".read": "root.child('delegacoes').child($comiteId).child($delegacaoId).child('membros').child(auth.uid).val() === true"
        }
      }
    },
    "avisos": {
      "$comiteId": {
        ".read": "auth != null && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
        ".write": "auth.token.email === 'aluizio@aluizio.education'"
      }
    },
    "simulacao": {
      "$comiteId": {
        "crise": {
          ".read": "auth != null && (auth.token.email === 'aluizio@aluizio.education' || root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists())",
          ".write": "auth.token.email === 'aluizio@aluizio.education'"
        },
        "solucoes": {
          ".read": "auth.token.email === 'aluizio@aluizio.education' || (auth != null && root.child('simulacao').child($comiteId).child('crise').child('status').val() === 'plenario' && (root.child('config/inviteOnly').val() !== true || root.child('autorizados').child(auth.uid).exists()))",
          ".write": "auth.token.email === 'aluizio@aluizio.education'",
          "$delegacaoId": {
            ".read": "auth != null && root.child('delegacoes').child($comiteId).child($delegacaoId).child('membros').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('delegacoes').child($comiteId).child($delegacaoId).child('membros').child(auth.uid).val() === true && root.child('simulacao').child($comiteId).child('crise').child('status').val() === 'no_ar'"
          }
        },
        "historico": {
          ".read": "auth.token.email === 'aluizio@aluizio.education'",
          ".write": "auth.token.email === 'aluizio@aluizio.education'"
        }
      }
    },
    "quizGeopolitica": {
      ".read": "auth.token.email === 'aluizio@aluizio.education'",
      ".write": "auth.token.email === 'aluizio@aluizio.education'",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['aluno','acertos','total','enviadoEm'])",
        "aluno": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "acertos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100"
        },
        "erradas": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "enviadoEm": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "pesquisa": {
      "$comiteId": {
        ".read": "auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.token.email === 'aluizio@aluizio.education'",
        "$uid": {
          ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'",
          ".write": "auth.uid === $uid"
        }
      }
    },
    "materiais": {
      "publico": {
        ".read": "auth != null",
        ".write": "auth.token.email === 'aluizio@aluizio.education'"
      },
      "turma": {
        ".read": "auth.token.email === 'aluizio@aluizio.education' || root.child('autorizados').child(auth.uid).exists()",
        ".write": "auth.token.email === 'aluizio@aluizio.education'"
      },
      "restrito": {
        ".read": "auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.token.email === 'aluizio@aluizio.education'"
      },
      "alunos": {
        ".read": "auth.token.email === 'aluizio@aluizio.education'",
        ".write": "auth.token.email === 'aluizio@aluizio.education'",
        "$uid": {
          ".read": "auth.uid === $uid || auth.token.email === 'aluizio@aluizio.education'"
        }
      }
    }
  }
}
