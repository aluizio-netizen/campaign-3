# Copie para .env e ajuste os valores. NUNCA versione segredos reais.

# ── Banco de dados ──────────────────────────────────────────────────────────
# DATABASE_PROVIDER: sqlite (local) | postgresql (Render). O build ajusta o
# schema automaticamente — não edite prisma/schema.prisma à mão.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# Render: DATABASE_PROVIDER="postgresql" e DATABASE_URL=postgres://...

# ── Mídia (áudios/páginas) ──────────────────────────────────────────────────
# Vazio = /public (local). Produção: URL do bucket R2/S3/CDN.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ── Autenticação (NextAuth) ─────────────────────────────────────────────────
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
NEXTAUTH_URL="http://localhost:3000"

# ── Professor IA ────────────────────────────────────────────────────────────
# Sem AI_API_KEY o app funciona em modo DEMO (respostas simuladas).
AI_PROVIDER="demo"           # demo | openai | anthropic
AI_API_KEY=""
AI_MODEL=""

# ── Conta admin inicial (seed) ──────────────────────────────────────────────
ADMIN_EMAIL="admin@missaoingles.com"
ADMIN_PASSWORD="troque-esta-senha"
DEMO_STUDENT_EMAIL="aluno@missaoingles.com"
DEMO_STUDENT_PASSWORD="troque-esta-senha"
